# ==========================================================
# MedIntelliX .gitignore
# Security First: Protect Environment Variables & Credentials
# ==========================================================

# Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node Dependencies
node_modules/
backend/node_modules/

# Local databases & persistent caches
backend/data/
*.db
*.sqlite

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
